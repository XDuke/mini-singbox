[Unit]
Description=mini-singbox single-user proxy
After=network.target

[Service]
Type=simple
User=mini-singbox
Group=mini-singbox
WorkingDirectory=/etc/mini-singbox
ExecStart=/usr/local/bin/mini-singbox run -c /etc/mini-singbox/config.json
Environment=GOMAXPROCS=1
Environment=GOMEMLIMIT=48MiB
Environment=GOGC=70
EnvironmentFile=-/etc/default/mini-singbox
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
