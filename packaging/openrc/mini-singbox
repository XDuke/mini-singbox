#!/sbin/openrc-run

name="mini-singbox"
description="mini-singbox single-user proxy"
command="/usr/local/bin/mini-singbox"
command_args="run -c /etc/mini-singbox/config.json"
command_user="mini-singbox:mini-singbox"
directory="/etc/mini-singbox"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=5
respawn_period=60

: "${GOMAXPROCS:=1}"
: "${GOMEMLIMIT:=48MiB}"
: "${GOGC:=70}"
export GOMAXPROCS GOMEMLIMIT GOGC

depend() {
	need net
	after firewall
}
