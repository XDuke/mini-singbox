#!/bin/sh
set -eu

BINARY="${MINI_SINGBOX_BINARY:-/usr/local/bin/mini-singbox}"
CONFIG_DIR="${MINI_SINGBOX_CONFIG_DIR:-/etc/mini-singbox}"
CONFIG_PATH="$CONFIG_DIR/config.json"
CLIENT_INFO_PATH="$CONFIG_DIR/client-info.json"
TUNE_STATE_DIR="${MINI_SINGBOX_TUNE_STATE_DIR:-/var/lib/mini-singbox/tune}"
SERVICE="${MINI_SINGBOX_SERVICE:-mini-singbox.service}"
SERVICE_USER="${MINI_SINGBOX_SERVICE_USER:-mini-singbox}"
SERVICE_GROUP="${MINI_SINGBOX_SERVICE_GROUP:-$SERVICE_USER}"
SYSTEMCTL="${MINI_SINGBOX_SYSTEMCTL:-systemctl}"
QRENCODE="${MINI_SINGBOX_QRENCODE:-qrencode}"
OPENSSL="${MINI_SINGBOX_OPENSSL:-openssl}"
JQ="${MINI_SINGBOX_JQ:-jq}"
SS="${MINI_SINGBOX_SS:-ss}"

fail() {
	printf 'mini-singboxctl: %s\n' "$*" >&2
	exit 1
}

RENEW_WORK=""
RENEW_BACKUP=""
RENEW_SWITCHED=0
RENEW_COMMITTED=0

renew_cleanup() {
	status=$?
	trap - EXIT HUP INT TERM
	if [ "$RENEW_SWITCHED" -eq 1 ] && [ "$RENEW_COMMITTED" -eq 0 ]; then
		printf 'mini-singboxctl: certificate renewal failed; restoring the previous configuration\n' >&2
		"$SYSTEMCTL" stop "$SERVICE" >/dev/null 2>&1 || true
		if ! rm -rf -- "$CONFIG_DIR"; then
			printf 'mini-singboxctl: could not remove the failed replacement configuration\n' >&2
		elif ! cp -a "$RENEW_BACKUP" "$CONFIG_DIR"; then
			printf 'mini-singboxctl: CRITICAL: could not restore the previous configuration from %s\n' "$RENEW_BACKUP" >&2
		elif ! "$SYSTEMCTL" start "$SERVICE" >/dev/null 2>&1; then
			printf 'mini-singboxctl: previous configuration was restored but the service did not restart\n' >&2
		fi
	fi
	case "$RENEW_WORK" in
		/var/tmp/mini-singbox-renew.*|/tmp/mini-singbox-renew.*) rm -rf -- "$RENEW_WORK" ;;
		"") ;;
		*) printf 'mini-singboxctl: refusing to remove unexpected renewal directory %s\n' "$RENEW_WORK" >&2 ;;
	esac
	exit "$status"
}

usage() {
	cat <<'EOF'
usage: mini-singboxctl <status|check|certificate|qr|logs|tune|version> [options]

commands:
  status                   validate config, service, listeners, memory, and TLS expiry
  check                    validate the installed configuration
  certificate              show TLS certificate expiry and fail inside 30 days
  certificate renew        rotate only the TLS certificate/key with guarded rollback
  qr [reality|hy2|anytls|all]
                           render sensitive protocol QR codes and sharing links
  logs [LINES]             show 1-1000 recent service log lines (default 100)
  tune <detect|plan|apply|verify|status|rollback> [options]
                           inspect or manage conservative, reversible TCP tuning
  version                  show the installed binary build identity
EOF
}

command_available() {
	case "$1" in
		*/*) [ -x "$1" ] ;;
		*) command -v "$1" >/dev/null 2>&1 ;;
	esac
}

require_command() {
	command_available "$1" || fail "required command not found: $1"
}

require_installation() {
	[ -x "$BINARY" ] || fail "binary is not executable: $BINARY"
	if [ ! -f "$CONFIG_PATH" ] || [ -L "$CONFIG_PATH" ]; then
		fail "configuration is missing or unsafe: $CONFIG_PATH"
	fi
}

run_check() {
	if [ "$(id -u)" -eq 0 ] && command -v runuser >/dev/null 2>&1 && id "$SERVICE_USER" >/dev/null 2>&1; then
		runuser -u "$SERVICE_USER" -- "$BINARY" check -c "$CONFIG_PATH"
	else
		"$BINARY" check -c "$CONFIG_PATH"
	fi
}

detect_init() {
	if [ "${MINI_SINGBOX_INIT_SYSTEM:-auto}" != "auto" ]; then
		printf '%s\n' "$MINI_SINGBOX_INIT_SYSTEM"
	elif command_available "$SYSTEMCTL" && [ -d /run/systemd/system ]; then
		printf 'systemd\n'
	else
		printf 'unknown\n'
	fi
}

service_is_active() {
	case "$1" in
		systemd) "$SYSTEMCTL" is-active --quiet "$SERVICE" ;;
		*) return 1 ;;
	esac
}

certificate_paths() {
	require_command "$JQ"
	"$JQ" -er '
		[.hysteria2.certificate_path, .anytls.certificate_path]
		| map(select(. != null and . != ""))
		| unique
		| if length == 0 then error("no TLS certificate") else .[] end
	' "$CONFIG_PATH" 2>/dev/null
}

show_certificate() {
	require_installation
	require_command "$OPENSSL"
	require_command "$JQ"
	"$JQ" -e 'type == "object"' "$CONFIG_PATH" >/dev/null 2>&1 || \
		fail "cannot read configuration JSON: $CONFIG_PATH"
	configured_certificates="$(certificate_paths)" || {
		printf 'TLS certificate: not used by the enabled protocols\n'
		return 0
	}
	printf '%s\n' "$configured_certificates" | while IFS= read -r configured; do
		case "$configured" in
			/*) certificate="$configured" ;;
			*) certificate="$CONFIG_DIR/$configured" ;;
		esac
		if [ ! -f "$certificate" ] || [ -L "$certificate" ]; then
			fail "TLS certificate is missing or unsafe: $certificate"
		fi
		expires="$($OPENSSL x509 -in "$certificate" -noout -enddate 2>/dev/null)" || \
			fail "cannot inspect TLS certificate: $certificate"
		if "$OPENSSL" x509 -in "$certificate" -noout -checkend 2592000 >/dev/null 2>&1; then
			printf 'TLS certificate: valid beyond 30 days (%s)\n' "${expires#notAfter=}"
		else
			printf 'TLS certificate: expires within 30 days (%s)\n' "${expires#notAfter=}" >&2
			exit 1
		fi
	done
}

renew_certificate() {
	require_installation
	[ "$(id -u)" -eq 0 ] || fail "certificate renewal must run as root"
	[ "$(detect_init)" = "systemd" ] || fail "certificate renewal requires a running systemd environment"
	"$SYSTEMCTL" is-active --quiet "$SERVICE" || fail "service must be active before certificate renewal"
	for required in "$JQ" "$QRENCODE" runuser mktemp install cp; do
		require_command "$required"
	done
	if [ ! -f "$CLIENT_INFO_PATH" ] || [ -L "$CLIENT_INFO_PATH" ]; then
		fail "client information is missing or unsafe: $CLIENT_INFO_PATH"
	fi
	[ ! -L "$CONFIG_DIR" ] || fail "configuration directory must not be a symbolic link: $CONFIG_DIR"
	case "$CONFIG_DIR" in
		/etc/mini-singbox|/tmp/*|/var/tmp/*) ;;
		*) fail "refusing certificate renewal in an unexpected configuration directory: $CONFIG_DIR" ;;
	esac
	public_address="$($JQ -er '.public_address' "$CLIENT_INFO_PATH")" || \
		fail "client information does not contain a public address"
	reality_port="$($JQ -r '.vless_reality.port // 0' "$CLIENT_INFO_PATH")"
	hy2_port="$($JQ -r '.hysteria2.port // 0' "$CLIENT_INFO_PATH")"
	anytls_port="$($JQ -r '.anytls.port // 0' "$CLIENT_INFO_PATH")"
	allow_insecure_anytls=0
	if "$JQ" -e '(.anytls.share_uri // "") | startswith("anytls://")' \
		"$CLIENT_INFO_PATH" >/dev/null 2>&1; then
		allow_insecure_anytls=1
	fi

	RENEW_WORK="$(mktemp -d /var/tmp/mini-singbox-renew.XXXXXX)" || \
		fail "cannot create certificate renewal workspace"
	case "$RENEW_WORK" in
		/var/tmp/mini-singbox-renew.*) ;;
		*) fail "mktemp returned an unsafe renewal directory" ;;
	esac
	# The service account must traverse the root-owned workspace to reach its
	# own 0700 staging directory, but must not be able to list the parent.
	chmod 0711 "$RENEW_WORK"
	generated="$RENEW_WORK/generated"
	RENEW_BACKUP="$RENEW_WORK/config-backup"
	trap renew_cleanup EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	install -d -m 0700 -o "$SERVICE_USER" -g "$SERVICE_GROUP" "$generated"

	runuser -u "$SERVICE_USER" -- "$BINARY" renew-certificate \
		-c "$CONFIG_PATH" \
		--output "$generated" \
		--public-address "$public_address" \
		--reality-port "$reality_port" \
		--hy2-port "$hy2_port" \
		--anytls-port "$anytls_port" \
		--allow-insecure-anytls-share="$allow_insecure_anytls" >/dev/null
	for qr_source in share-reality share-hysteria2 share-anytls; do
		if [ -f "$generated/$qr_source.txt" ]; then
			"$QRENCODE" -l M -t PNG -o "$generated/$qr_source.png" < "$generated/$qr_source.txt"
			chown "$SERVICE_USER:$SERVICE_GROUP" "$generated/$qr_source.png"
			chmod 0600 "$generated/$qr_source.png"
		fi
	done
	for required_output in tls.crt tls.key client-info.json; do
		if [ ! -f "$generated/$required_output" ] || [ -L "$generated/$required_output" ]; then
			fail "renewal output is missing or unsafe: $required_output"
		fi
	done
	cp -a "$CONFIG_DIR" "$RENEW_BACKUP"
	RENEW_SWITCHED=1
	"$SYSTEMCTL" stop "$SERVICE"
	for renewal_file in \
		tls.crt tls.key client-info.json client-anytls-sing-box-outbound.json \
		share-reality.txt share-hysteria2.txt share-anytls.txt \
		share-reality.png share-hysteria2.png share-anytls.png; do
		if [ -f "$generated/$renewal_file" ] && [ ! -L "$generated/$renewal_file" ]; then
			case "$renewal_file" in
				tls.crt) mode=0644 ;;
				*) mode=0600 ;;
			esac
			install -m "$mode" -o "$SERVICE_USER" -g "$SERVICE_GROUP" \
				"$generated/$renewal_file" "$CONFIG_DIR/$renewal_file"
		else
			case "$renewal_file" in
				tls.crt|tls.key|client-info.json) fail "renewal output is missing $renewal_file" ;;
				*) rm -f -- "$CONFIG_DIR/$renewal_file" ;;
			esac
		fi
	done
	run_check >/dev/null
	"$SYSTEMCTL" start "$SERVICE"
	sleep 3
	"$SYSTEMCTL" is-active --quiet "$SERVICE" || fail "service did not remain active after certificate renewal"
	show_certificate >/dev/null
	RENEW_COMMITTED=1
	RENEW_SWITCHED=0
	printf 'TLS certificate renewed; protocol credentials and Reality keys were preserved.\n'
	printf 'Re-import Hysteria2 and AnyTLS client delivery because their certificate authentication changed.\n'
}

socket_is_listening() {
	transport="$1"
	port="$2"
	require_command "$SS"
	case "$transport" in
		tcp) socket_output="$($SS -lntH)" ;;
		udp) socket_output="$($SS -lnuH)" ;;
		*) return 1 ;;
	esac
	printf '%s\n' "$socket_output" | awk -v port="$port" '
		$4 ~ (":" port "$") { found = 1 }
		END { exit !found }
	'
}

show_protocol() {
	key="$1"
	label="$2"
	transport="$3"
	active="$4"
	port="$($JQ -er ".${key}.port // empty" "$CONFIG_PATH" 2>/dev/null || true)"
	[ -n "$port" ] || return 0
	listener="not listening"
	if [ "$active" -eq 1 ] && socket_is_listening "$transport" "$port"; then
		listener="listening"
	else
		STATUS_FAILURE=1
	fi
	printf '%-12s %s/%s, %s\n' "$label:" "$transport" "$port" "$listener"
	public_port="$($JQ -er ".${key}.port // empty" "$CLIENT_INFO_PATH" 2>/dev/null || true)"
	if [ -n "$public_port" ]; then
		printf '%-12s %s/%s\n' "$label public:" "$transport" "$public_port"
	fi
}

show_status() {
	require_installation
	require_command "$JQ"
	STATUS_FAILURE=0
	version_output="$("$BINARY" version)" || fail "cannot read the installed binary version"
	version_line="$(printf '%s\n' "$version_output" | sed -n '1p')"
	printf 'version:      %s\n' "$version_line"
	if run_check >/dev/null 2>&1; then
		printf 'configuration: valid\n'
	else
		printf 'configuration: invalid\n' >&2
		STATUS_FAILURE=1
	fi

	init_system="$(detect_init)"
	active=0
	if service_is_active "$init_system"; then
		active=1
		printf 'service:      active (%s)\n' "$init_system"
	else
		printf 'service:      inactive or unavailable (%s)\n' "$init_system" >&2
		STATUS_FAILURE=1
	fi
	if [ "$init_system" = "systemd" ] && [ "$active" -eq 1 ]; then
		pid="$($SYSTEMCTL show "$SERVICE" -p MainPID --value)"
		memory="$($SYSTEMCTL show "$SERVICE" -p MemoryCurrent --value)"
		tasks="$($SYSTEMCTL show "$SERVICE" -p TasksCurrent --value)"
		memory_mib="$(awk -v bytes="$memory" 'BEGIN { if (bytes ~ /^[0-9]+$/) printf "%.1f", bytes / 1048576; else print "unknown" }')"
		printf 'process:      PID %s, memory %s MiB, tasks %s\n' "$pid" "$memory_mib" "$tasks"
	fi

	public_address="$($JQ -r '.public_address // "not recorded"' "$CLIENT_INFO_PATH" 2>/dev/null || printf 'not recorded')"
	printf 'public address: %s\n' "$public_address"
	show_protocol vless_reality Reality tcp "$active"
	show_protocol hysteria2 Hysteria2 udp "$active"
	show_protocol anytls AnyTLS tcp "$active"
	if ! show_certificate; then
		STATUS_FAILURE=1
	fi
	return "$STATUS_FAILURE"
}

show_qr() {
	protocol="${1:-all}"
	case "$protocol" in
		reality|hy2|anytls|all) ;;
		*) fail "qr protocol must be reality, hy2, anytls, or all" ;;
	esac
	require_installation
	require_command "$JQ"
	require_command "$QRENCODE"
	printf 'WARNING: QR codes and sharing links contain client credentials; do not share terminal output.\n' >&2
	found=0
	for mapping in \
		reality:vless_reality:share-reality \
		hy2:hysteria2:share-hysteria2 \
		anytls:anytls:share-anytls; do
		name="${mapping%%:*}"
		remainder="${mapping#*:}"
		config_key="${remainder%%:*}"
		file="${remainder#*:}"
		if [ "$protocol" != "all" ] && [ "$protocol" != "$name" ]; then
			continue
		fi
		if ! "$JQ" -e ".${config_key} != null" "$CONFIG_PATH" >/dev/null 2>&1; then
			if [ "$protocol" = "$name" ]; then
				fail "$name is not enabled in $CONFIG_PATH"
			fi
			continue
		fi
		path="$CONFIG_DIR/$file.txt"
		if [ -f "$path" ] && [ ! -L "$path" ]; then
			share_link=''
			{
				IFS= read -r share_link || fail "share link must be one newline-terminated line: $path"
				if IFS= read -r _; then
					fail "share link must contain exactly one line: $path"
				fi
			} < "$path"
			[ -n "$share_link" ] || fail "share link is empty: $path"
			if printf '%s' "$share_link" | LC_ALL=C grep -q '[[:cntrl:]]'; then
				fail "share link contains control characters: $path"
			fi
			case "$name:$share_link" in
				reality:vless://*|hy2:hysteria2://*|anytls:anytls://*) ;;
				*) fail "share link scheme does not match enabled protocol $name: $path" ;;
			esac
			printf '\n%s\n' "$name"
			printf '%s\n' "$share_link" | "$QRENCODE" -t ANSIUTF8
			printf 'link (sensitive): %s\n' "$share_link"
			found=1
		else
			if [ "$name" = "anytls" ] && \
				[ -f "$CONFIG_DIR/client-anytls-sing-box-outbound.json" ] && \
				[ ! -L "$CONFIG_DIR/client-anytls-sing-box-outbound.json" ]; then
				if "$JQ" -e '(.anytls.share_uri // "") | startswith("anytls://")' \
					"$CLIENT_INFO_PATH" >/dev/null 2>&1; then
					fail "explicitly enabled AnyTLS share link is missing or unsafe: $path"
				fi
				if [ "$protocol" = "all" ]; then
					printf 'WARNING: AnyTLS QR skipped because its standard URI cannot authenticate a self-signed certificate; use %s/client-anytls-sing-box-outbound.json.\n' "$CONFIG_DIR" >&2
					continue
				fi
				fail "AnyTLS QR is disabled by the authenticated default; use $CONFIG_DIR/client-anytls-sing-box-outbound.json or explicitly redeploy with MINI_SINGBOX_ALLOW_INSECURE_ANYTLS_SHARE=1"
			fi
			fail "share link is missing or unsafe: $path"
		fi
	done
	[ "$found" -eq 1 ] || fail "no protocol share links were found in $CONFIG_DIR"
}

show_logs() {
	lines="${1:-100}"
	case "$lines" in
		''|*[!0-9]*) fail "log line count must be an integer from 1 to 1000" ;;
	esac
	if [ "$lines" -lt 1 ] || [ "$lines" -gt 1000 ]; then
		fail "log line count must be an integer from 1 to 1000"
	fi
	case "$(detect_init)" in
		systemd) exec "$SYSTEMCTL" status "$SERVICE" --no-pager --lines "$lines" ;;
		*) fail "a running systemd environment is required" ;;
	esac
}

command="${1:-}"
case "$command" in
	status)
		[ "$#" -eq 1 ] || fail "status does not accept arguments"
		show_status
		;;
	check)
		[ "$#" -eq 1 ] || fail "check does not accept arguments"
		require_installation
		run_check
		;;
	certificate)
		if [ "$#" -eq 1 ]; then
			show_certificate
		elif [ "$#" -eq 2 ] && [ "$2" = "renew" ]; then
			renew_certificate
		else
			fail "certificate accepts only the optional renew subcommand"
		fi
		;;
	qr)
		[ "$#" -le 2 ] || fail "qr accepts at most one protocol"
		show_qr "${2:-all}"
		;;
	logs)
		[ "$#" -le 2 ] || fail "logs accepts at most one line count"
		show_logs "${2:-100}"
		;;
	tune)
		[ "$#" -ge 2 ] || fail "tune requires a subcommand"
		require_installation
		shift
		exec "$BINARY" tune "$@" -c "$CONFIG_PATH" --state-dir "$TUNE_STATE_DIR"
		;;
	version)
		[ "$#" -eq 1 ] || fail "version does not accept arguments"
		[ -x "$BINARY" ] || fail "binary is not executable: $BINARY"
		exec "$BINARY" version
		;;
	-h|--help|help)
		[ "$#" -eq 1 ] || fail "help does not accept arguments"
		usage
		;;
	*)
		usage >&2
		exit 2
		;;
esac
